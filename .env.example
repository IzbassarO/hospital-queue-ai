# Copy to .env and adjust (or run `make env`, which copies this file and fills POSTGRES_PASSWORD and DEMO_API_KEY with
# random values; `make demo` does that for a fresh clone). Used by docker-compose, backend and ml pipelines.
POSTGRES_USER=hqai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hqai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Override the digest-pinned PostgreSQL image, e.g. in a closed network where the image is loaded from a tar
# (docker load does not restore repo digests) or pulled from a site registry: POSTGRES_IMAGE=postgres:16-bookworm
# POSTGRES_IMAGE=

# Login role the API serves requests with. Set both to let db/init.sql create a role that is not a superuser and
# has no DDL rights: SELECT on the read tables, INSERT on decision_log / specialist_decision / access_log, UPDATE
# on api_keys. Migrations, the seed loader and the ML pipelines keep POSTGRES_USER. Left empty (the demo default)
# the API also uses POSTGRES_USER. Two conditions for the role to appear: the PostgreSQL container must receive
# these two variables (db/init.sql reads them), and it must be initialising a new data directory. On a database
# that already exists, apply the SQL in docs/security.md §5 once instead.
# APP_DB_USER=hqai_app
# APP_DB_PASSWORD=

# Connection pool and per-statement limit of the API process (backend/app/db/session.py). DB_POOL_TIMEOUT is how
# long a request waits for a free connection before failing; DB_STATEMENT_TIMEOUT_MS caps a single query.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=5
# DB_STATEMENT_TIMEOUT_MS=15000

# Application log: one JSON line per event on stdout (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO

# Networks whose X-Forwarded-For the access log believes (JSON list). The default covers the docker bridge, where
# the only peer is the UI's nginx; a request arriving from anywhere else is recorded with its own address, so the
# header cannot be forged into the audit trail.
# TRUSTED_PROXY_CIDRS=["172.16.0.0/12","127.0.0.0/8","::1/128"]

# Network of the reverse proxy that terminates TLS, passed to uvicorn by docker-compose.prod.yml only; it decides
# whose X-Forwarded-Proto/For uvicorn believes. Leave unset for the demo stack.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# Host ports of the docker stack. Postgres and the API bind to 127.0.0.1 only; the UI binds to UI_BIND (every
# interface by default, so a phone or a second laptop on the same network can open the demo). Change a port when the
# default is already taken on this machine (`make demo` prints the URLs it ends up with).
# POSTGRES_PORT=5432
# API_PORT=8000
# FRONTEND_PORT=3000
# UI_BIND=0.0.0.0
# VITE_SYNTHETIC=off — build the UI without the synthetic layer (frontend/src/synthetic/README.md)

# DuckDB resources for the ingest pipeline
DUCKDB_MEMORY_LIMIT=4GB

# Demo API key (role specialist), seeded into api_keys when the backend container starts and added to proxied
# requests by the frontend's nginx (and by the Vite dev server) so the UI works without logging in. The browser
# never receives it, but anyone who can reach the UI acts with this key (docs/security.md). Generate one
# (`make env` does this when it creates .env):
#   python3 -c 'import secrets; print("hqai_" + secrets.token_urlsafe(32))'
# Leave empty to disable the demo key (the UI then shows "API key required").
DEMO_API_KEY=

# AI assistant proxy (POST /api/v1/assistant): provider key stays on the server; empty = assistant "не подключён"
ASSISTANT_PROVIDER=groq
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
