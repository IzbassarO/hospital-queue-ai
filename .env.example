# Copy to .env and adjust. Used by docker-compose, backend and ml pipelines.
POSTGRES_USER=hqai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hqai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DuckDB resources for the ingest pipeline
DUCKDB_MEMORY_LIMIT=4GB

# Demo API key (role specialist), seeded into api_keys when the backend container starts and baked into the
# frontend build so the UI works without logging in. Anyone who can open the UI acts with this key
# (docs/security.md). Generate one:
#   python3 -c 'import secrets; print("hqai_" + secrets.token_urlsafe(32))'
# Leave empty to disable the demo key (the UI then shows "API key required").
DEMO_API_KEY=
