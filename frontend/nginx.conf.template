# Static SPA + reverse proxy to the API (docker compose service `backend`).
#
# Rendered at container start from this template by the nginx entrypoint (envsubst, NGINX_ENVSUBST_FILTER limits
# substitution to DEMO_API_KEY, so nginx's own $variables stay untouched).
#
# The demo API key lives ONLY here, server-side: the browser never receives it and the bundle does not contain it.
# A request that already carries X-API-Key (an operator using their own viewer/admin key) is passed through
# unchanged; a request without one gets the demo key. Anyone who can reach this port still acts with the demo
# key's role — see docs/security.md §3.
map $http_x_api_key $hqai_api_key {
    ""      "${DEMO_API_KEY}";
    default $http_x_api_key;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # container healthcheck; does not depend on the backend
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Docker's embedded DNS, re-resolved every 10 s: a recreated backend container (new IP) keeps working
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # server-side credential injection (see the note above); never echoed back to the browser
        proxy_set_header X-API-Key $hqai_api_key;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # hashed build assets never change
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # client-side routes (/regions/71, /hospitals/…): always index.html, never cached
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
